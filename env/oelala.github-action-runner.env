# VOORBEELD per-project omgeving (optioneel bij de centrale pool).
# Elk project dat eigen omgeving nodig heeft, kan dit als naamgeving gebruiken:
#   <project>.github-action-runner.env
# en dit naast de common basis environment in de runnende job laden,
# bijv. via een `env`-blok in de workflow of door het bestand te sourcen.
#
# Belangrijk: er is dus GEEN aparte runner per project nodig — alle runners
# zijn org-scoped en dienen ELK project. Alleen project-specifieke TOOLS/ENV
# worden hierin gedeclareerd.

# --- oelala specifiek (voorbeeld: GPU + lokale venv) ---
# CUDA_VISIBLE_DEVICES=0,1
# PATH=/home/flip/venvs/gpu/bin:$PATH

# Opmerking over GPU: alle runners hebben het `gpu`-label (de hele pool is
# GPU-capabel op deze ene machine). Dit project bepaalt in zijn workflow of en
# hoe het de GPU inzet — via env hieronder of een `env`-blok in de job:
#
#   jobs:
#     train:
#       runs-on: [self-hosted, Linux, gpu]
#       env:
#         CUDA_VISIBLE_DEVICES: "0"
#
# Niet-GPU jobs targeten gewoon [self-hosted, Linux]. De keuze zit in het project,
# niet in een aparte runner.
