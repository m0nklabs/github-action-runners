# Gemeenschappelijke omgeving voor de centrale self-hosted runners.
# Dit bestand wordt als basis-`.env` in elke runner-installatie geplaatst.
# Per-project overrides: zie env/<project>.github-action-runner.env — IEDERE runner
# is org-scoped (werkt voor alle projecten); project-specifieke omgeving wordt
# per-project aangeleverd (naast dit common-bestand), NIET door aparte runners.

# --- talen / locale ---
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# --- HOME en basis-PATH ---
HOME=/home/flip

# --- Git / GitHub ---
GITHUB_ACTIONS=true
RUNNER_ALLOW_RUNASROOT=0

# Je mag hier extra permanent benodigde omgeving zetten die voor ALLE runners geldt.
